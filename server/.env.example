# Safe examples only. Keep the real .env outside the published site and Git.
# Use a fully downloaded encrypted package mirrored from private SharePoint.
PPC_PACKAGE_FILE=C:/ApprovedPackageMirror/master_ppc.pkg
PPC_ALLOWED_ORIGINS=https://monocraft.github.io
PPC_BIND_HOST=127.0.0.1
PPC_PORT=8787
PPC_RATE_LIMIT=30
PPC_RATE_WINDOW_MS=60000
PPC_MAX_CONCURRENT=2
# Leave empty unless your HTTPS proxy overwrites X-Forwarded-For with one IP.
# For a proxy on the same host, explicitly trust its loopback peer address.
PPC_TRUSTED_PROXY_IPS=
