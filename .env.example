# Private backend settings. This example contains no credentials.
# Supply real values in the server's private environment, never in Pages variables.
PPC_MASTER_STORAGE=github
PPC_GITHUB_TOKEN=
PPC_ALLOWED_ORIGINS=https://monocraft.github.io
PPC_BIND_HOST=127.0.0.1
PORT=8788

# For a network listener, set PPC_BIND_HOST=0.0.0.0 behind an HTTPS reverse proxy,
# or supply both certificate files below for native HTTPS.
PPC_TLS_CERT_FILE=
PPC_TLS_KEY_FILE=

# The public site uses only the deployed backend address, not the credential:
# PPC_MASTER_ENDPOINT=https://YOUR-REAL-SERVER/api/master
